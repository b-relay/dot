{
  "name": "dot",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build --compile index.ts --outfile dot",
    "build:release": "bun build --compile --minify index.ts --outfile dot",
    "deploy": "bun run build && mkdir -p ~/.local/bin && cp dot ~/.local/bin/dot && chmod +x ~/.local/bin/dot",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "zod": "^4.3.6"
  }
}
