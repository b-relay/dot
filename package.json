{
  "name": "dot",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build --compile index.ts --outfile dot",
    "deploy": "bun run build && mkdir -p ~/.local/bin && cp dot ~/.local/bin/dot && chmod +x ~/.local/bin/dot",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/write-file-atomic": "^4.0.3",
    "typescript": "^5"
  },
  "dependencies": {
    "@logtape/logtape": "^2.0.2",
    "write-file-atomic": "^7.0.0"
  }
}
